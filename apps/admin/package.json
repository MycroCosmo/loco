{
  "name": "loco-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "pretypecheck": "node scripts/check-toolchain.mjs",
    "predev": "node scripts/check-toolchain.mjs",
    "pretest:e2e": "node scripts/check-toolchain.mjs"
  },
  "dependencies": {
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
